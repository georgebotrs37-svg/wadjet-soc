# Copy this file to .env and fill in the SIEM connection values.
# Never commit real credentials or paste them into chat.

# Wazuh Indexer REST API. Use a dedicated read-only indexer account.
WAZUH_INDEXER_URL=https://wazuh-indexer.example.internal:9200
WAZUH_INDEXER_USERNAME=
WAZUH_INDEXER_PASSWORD=
WAZUH_INDEXER_INDEX_PATTERN=wazuh-alerts-4.x-*
WAZUH_INDEXER_VERIFY_TLS=true
# Optional path to a PEM CA certificate for a private/self-signed CA.
WAZUH_INDEXER_CA_BUNDLE=

# Splunk management/API base URL and a read-only bearer token.
SPLUNK_URL=https://splunk.example.internal:8089
SPLUNK_TOKEN=
# Provide a read-only SPL query appropriate for your Splunk indexes/sourcetypes.
# Example: search index=security sourcetype=alerts | head 100
SPLUNK_SEARCH_QUERY=
SPLUNK_VERIFY_TLS=true
# Optional path to a PEM CA certificate for a private/self-signed CA.
SPLUNK_CA_BUNDLE=
